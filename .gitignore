# Environment variables & secrets (NEVER commit API keys)
.env
.env.*
!.env.example

# Python & uv virtual environments
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Data & local index artifacts (regenerated via ingest & index pipelines)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/index/*
!data/index/.gitkeep
*.bsp

# Evaluation outputs (keep golden.jsonl, results.jsonl, and summary metrics tracked)

# OS & Editor files
.DS_Store
.idea/
.vscode/
*.swp
