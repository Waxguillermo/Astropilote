# Environment variables & secrets (NEVER commit API keys)
.env
.env.*
!.env.example

# Python & uv virtual environments
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Data & local index artifacts (regenerated via ingest & index pipelines)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/index/*
!data/index/.gitkeep
*.bsp

# Evaluation outputs (keep golden.jsonl, results.jsonl, and summary metrics tracked)
# GEPA run directories: keep gepa_run.json / candidates.json, drop resumable state and raw logs.
eval/prompt_opt/*/gepa_state.bin
eval/prompt_opt/*/run_log*
eval/prompt_opt/*/generated_best_outputs_valset/
eval/prompt_opt/*/candidate_tree.html

# OS & Editor files
.DS_Store
.idea/
.vscode/
*.swp

# Astrometry.net & local ASTAP binaries / star databases
data/astrometry/
data/astap/
# Agentic Workflows & v1.2 local database / secrets / cache
data/backend/
data/*.sqlite3*
data/.secret_key
data/vision_cache/
# React / Vite frontend build outputs
frontend/node_modules/
frontend/dist/
