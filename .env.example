# ==============================================================================
# AstroPilote v1.1 — Environment Configuration (.env)
# ==============================================================================

# 1. LLM Mode: "local" (Ollama Gemma 4, default) or "api" (Anthropic Claude / OpenRouter)
LLM_MODE=local
# Chat answers fall back to the other backend when the selected one is down
# (evaluation runs and the Observatory agent never do)
LLM_BACKEND_FALLBACK=true

# 2. Local Mode (Primary — Ollama daemon)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# 3. Cloud API Mode (Anthropic / OpenRouter)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ROUTER_MODEL=claude-haiku-4.5

# 4. Hybrid Retrieval & Index Settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true
EVAL_OFFLINE_MODE=false

# 5. Guardrails, Harness Budgets & Ephemeris Thresholds (v1.1)
STRICT_CORPUS_GUARD=false
MAX_FORECAST_DAYS=14
MIN_OBSERVABLE_ALTITUDE_DEG=20.0
ALTITUDE_TOLERANCE_DEG=5.0
TWILIGHT_MARGIN_MINUTES=15
MAX_AGENT_STEPS=6
MAX_TOOL_CALLS=18
MAX_TOKENS_BUDGET=28000
MAX_COST_USD=0.25
TOOL_TIMEOUT_S=12.0
MAX_CONSECUTIVE_TOOL_ERRORS=2

# 6. Simulated Observatory studio (stateful MCP demo backend)
# The demo seeds schedule their slots on 17-20 Nov 2026, so the studio runs on a frozen clock
# and on weather / geocoding fixtures. Set OBSERVATORY_OFFLINE_SKY=false for live Open-Meteo data.
OBSERVATORY_REFERENCE_DATE=2026-11-14
OBSERVATORY_OFFLINE_SKY=true

# 7. Optional: comma-separated browser origins allowed to call the API (defaults to localhost:8000)
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
