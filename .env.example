# ==============================================================================
# AstroPilote v1.1 — Environment Configuration (.env)
# ==============================================================================

# 1. LLM Mode: "api" (Anthropic Claude) or "local" (Ollama / SmolLM2)
LLM_MODE=api

# 2. Anthropic API Mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 3. Local Mode (Ollama / HuggingFace SmolLM2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# 4. Hybrid Retrieval & Index Settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true
EVAL_OFFLINE_MODE=false

# 5. Guardrails & Observation Defaults (v1.1)
STRICT_CORPUS_GUARD=false
MAX_FORECAST_DAYS=14
MIN_OBSERVABLE_ALTITUDE_DEG=20.0
ALTITUDE_TOLERANCE_DEG=5.0
DEFAULT_LOCATION_NAME=Fontainebleau
DEFAULT_LAT=48.4047
DEFAULT_LON=2.7016
