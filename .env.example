# ==============================================================================
# AstroPilote — Environment Configuration (.env)
# ==============================================================================

# 1. LLM Mode: "api" (Anthropic Claude) or "local" (Ollama)
LLM_MODE=api

# 2. Anthropic API Mode (paste your course API key below)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 3. Local Mode (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# 4. Hybrid Retrieval & Index Settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true
EVAL_OFFLINE_MODE=false
