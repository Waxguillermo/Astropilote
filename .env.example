# ==============================================================================
# AstroPilote — Environment Configuration Template
# Copy this file to `.env` (`cp .env.example .env`) and adjust as needed.
# NEVER commit `.env` to version control.
# ==============================================================================

# --- 1. Local LLM Configuration (Gemma 4 via Ollama or local server for Google ADK) ---
OLLAMA_BASE_URL=http://localhost:11434
ASTROPILOTE_LLM_PROVIDER=ollama
ASTROPILOTE_LLM_MODEL=gemma4
ASTROPILOTE_LLM_TEMPERATURE=0.0

# --- 2. Optional Cloud API Keys (for local vs API model comparison & LLM Judge) ---
# Leave empty for 100% local-first execution ($0.00 / query)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ASTROPILOTE_JUDGE_MODEL=gemma4

# --- 3. Retrieval & Indexing Models (Open-Weight Hugging Face IDs) ---
ASTROPILOTE_EMBEDDING_MODEL=BAAI/bge-m3
ASTROPILOTE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ASTROPILOTE_USE_RERANKER=true

# --- 4. Retrieval Hyperparameters ---
ASTROPILOTE_BM25_TOP_K=20
ASTROPILOTE_DENSE_TOP_K=20
ASTROPILOTE_RRF_K=60
ASTROPILOTE_FINAL_TOP_K=5
ASTROPILOTE_MAX_CHUNK_TOKENS=400

# --- 5. Agent & Tool Execution ---
ASTROPILOTE_MAX_AGENT_STEPS=6
ASTROPILOTE_MAX_COMPOSE_RETRIES=1
# Set to true during `eval/run_eval.py` to use deterministic weather/geocoding fixtures
ASTROPILOTE_EVAL_OFFLINE_MODE=false

# --- 6. Storage Paths ---
ASTROPILOTE_DATA_DIR=data
ASTROPILOTE_QDRANT_PATH=data/index/qdrant
ASTROPILOTE_BM25_PATH=data/index/bm25
