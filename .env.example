# ==============================================================================
# AstroPilote v1.2.0 — Environment Configuration (.env)
# ==============================================================================

# 1. Deployment & Hybrid Auth Mode: "local" (solo, zero login) or "cloud" (OAuth/Magic Link + BYOK)
AUTH_MODE=local
# Empty defaults to SQLite WAL under data/astropilote.sqlite3; set postgresql+psycopg://... in cloud
DATABASE_URL=
# Required in AUTH_MODE=cloud (>= 32 random chars: `openssl rand -hex 32`)
APP_SECRET_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8000
RATE_LIMIT_RPM=30

# 2. LLM Mode: "local" (Ollama Gemma 4, $0 default) or "api" (Anthropic / OpenRouter)
LLM_MODE=local
LLM_BACKEND_FALLBACK=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# 3. Cloud API Settings (local fallback only; AUTH_MODE=cloud uses per-user encrypted BYOK keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5.5
ROUTER_MODEL=claude-haiku-4.5

# 4. Lightweight ONNX Hybrid Retrieval (fastembed + float16 NumPy + BM25)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true
EVAL_OFFLINE_MODE=false

# 5. Blind Plate-Solving (Sky Vision: ASTAP local -> nova.astrometry.net -> manual TAN WCS)
ASTROMETRY_API_KEY=

# 6. Guardrails, Harness Budgets & Ephemeris Thresholds
STRICT_CORPUS_GUARD=false
MAX_FORECAST_DAYS=14
MIN_OBSERVABLE_ALTITUDE_DEG=20.0
ALTITUDE_TOLERANCE_DEG=5.0
TWILIGHT_MARGIN_MINUTES=15
MAX_AGENT_STEPS=6
MAX_TOOL_CALLS=18
MAX_TOKENS_BUDGET=28000
MAX_COST_USD=0.25
TOOL_TIMEOUT_S=12.0
MAX_CONSECUTIVE_TOOL_ERRORS=2

# 7. Optional: CORS origins & Arize Phoenix tracing
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:5173
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=astropilote
