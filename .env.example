# ==============================================================================
# AstroPilote v1.1 — Environment Configuration (.env)
# ==============================================================================

# 1. LLM Mode: "api" (Anthropic Claude / OpenRouter) or "local" (Ollama daemon)
LLM_MODE=api

# 2. Cloud API Mode (Anthropic / OpenRouter)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ROUTER_MODEL=claude-haiku-4.5

# 3. Local Mode (Ollama daemon required when LLM_MODE=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# 4. Hybrid Retrieval & Index Settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true
EVAL_OFFLINE_MODE=false

# 5. Guardrails & Ephemeris Thresholds (v1.1)
STRICT_CORPUS_GUARD=false
MAX_FORECAST_DAYS=14
MIN_OBSERVABLE_ALTITUDE_DEG=20.0
ALTITUDE_TOLERANCE_DEG=5.0
TWILIGHT_MARGIN_MINUTES=15
